<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textColor="@color/muted" />

    <LinearLayout
        android:id="@+id/servingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/card_green"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serving_now"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bigIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cell ID"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bigIdValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/srvLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/srvLte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/details_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/srvFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/details_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/srvSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/signalBars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/bar1"
                android:layout_width="16dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom"
                android:layout_marginEnd="3dp"
                android:background="@color/bar_off" />

            <View
                android:id="@+id/bar2"
                android:layout_width="16dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom"
                android:layout_marginEnd="3dp"
                android:background="@color/bar_off" />

            <View
                android:id="@+id/bar3"
                android:layout_width="16dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom"
                android:layout_marginEnd="3dp"
                android:background="@color/bar_off" />

            <View
                android:id="@+id/bar4"
                android:layout_width="16dp"
                android:layout_height="23dp"
                android:layout_gravity="bottom"
                android:background="@color/bar_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/srvChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPinTower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pin_tower" />
    </LinearLayout>

    <TextView
        android:id="@+id/pinnedTowerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/no_pinned_tower"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="-"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/tvAccessWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#FDECEA"
        android:padding="10dp"
        android:text="@string/access_warning"
        android:textColor="#B3261E"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/last_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@color/muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/refresh" />

        <Button
            android:id="@+id/btnOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/operator_settings" />

        <Button
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/about" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ToggleButton
            android:id="@+id/tglAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textOff="@string/auto_refresh"
            android:textOn="@string/auto_refresh" />

        <Button
            android:id="@+id/btnCallSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/call_settings" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
