<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_settings_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/accessibility_title"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/accessibility_hint"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/tvAccessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/accessibility_off"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enable_accessibility" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/call_number"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/call_number_hint"
            android:inputType="phone"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnSaveNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/out_duration"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOutDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="15"
            android:inputType="number"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/in_duration"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etInDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="15"
            android:inputType="number"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnSaveDurations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_durations" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pinned_tower"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinnedTower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_pinned_tower"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnPinTower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pin_current_tower" />

        <Button
            android:id="@+id/btnUnpinTower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/unpin_tower" />

        <Switch
            android:id="@+id/swAutomation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enable_automation"
            android:textColor="@color/ink" />

        <Switch
            android:id="@+id/swRepeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_repeat"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnCallNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/call_now" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_automation" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_status_idle"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
